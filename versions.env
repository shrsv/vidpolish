# versions.env - single source of truth for the vidpolish *build/packaging*
# toolchain (Go module deps are already pinned in go.mod/go.sum; runtime
# tools vidpolish fetches on demand are pinned in internal/binmgr/binmgr.go).
#
# Sourced by scripts/install-gui-toolchain.sh and the Makefile's gui-*
# targets. Bump a value here, re-run scripts/install-gui-toolchain.sh, and
# every build/packaging script picks it up.

# Go toolchain (matches the `go` directive in go.mod).
GO_VERSION=1.24.3

# Node.js (only needed for `make web-build` / `web-install`).
NODE_VERSION=24.13.0

# Wails CLI (github.com/wailsapp/wails/v2/cmd/wails) - builds and packages
# the native GUI (cmd/vidpolish-gui).
WAILS_VERSION=v2.10.1

# NSIS (makensis) - generates the Windows installer. Version is the
# apt candidate on Ubuntu 24.04 (noble); adjust if building on a different
# base image.
NSIS_VERSION=3.09

# mingw-w64 GCC - cross-compiles the cgo-based Windows GUI binary from
# Linux. Version is the apt candidate on Ubuntu 24.04 (noble).
MINGW_VERSION=13.2.0
